# Everything is LF in the repository and in every checkout: gofmt expects LF,
# and bash breaks on CR ("$'\r': command not found").
* text=auto eol=lf

# Windows-only scripts keep Windows line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binary content.
*.png binary
*.ico binary
*.exe binary
*.zip binary
