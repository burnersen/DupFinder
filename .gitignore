# --- Secrets: never commit (dev-starterkit 08-sicherheit.md) ---
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets/

# --- Build output: belongs to a release, not to the repository ---
*.exe
/dupfinder
/DupFinder
# go-winres output, made by the release workflow from winres/winres.json
*.syso
*.test

# --- Files the program writes when started from here ---
# FFmpeg, downloaded at runtime, never shipped
/bin/
# Runtime data: holds real file paths
/.DupFinder.data/
*.log
*.log.[0-9]
*.tmp
*.part

# --- Private notes, local start scripts and safety copies: never public ---
# Local start scripts carry private paths
*.bat
_notizen/
/_claude_memory/
README_BUILD.txt
_backup*/

# --- Editors and operating systems ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
